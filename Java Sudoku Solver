public class Main {
    public boolean isSafe ( char[][] board, int row, int col, int number) {
        //colum
        for(int i=0; i<board.length; i++) {// our cell will go through all the board
            if(board[i][col] == (char)(number+'0')) {//board er row number er equal hoye jay.
                return false;
            }
        }

        //row
        for(int j=0; j<board.length; j++) {
            if(board[row][j] == (char)(number+'0')) { //board er colum number er equal hoye jay
                return false;
            }
        }
        //grid

        int sr = (row/3) *3; // 3x3 grid
        int sc = (col/3) *3;

        for (int i=sr; i<sr+3; i++) {
            for (int j=sc; j<sc+3; j++) {
                if (board[i][j]==(char) (number + '0')) { // if there is already an equal number
                    return false;
                }
            }
        }
        return true; // if all is ok
    }
    public boolean helper(char [][] board, int row, int col) {
        //basecase

        if (row == board.length) { // our all row is equal to board length return true.
            return true;
        }

        int nrow = 0; // for next box initialyzation
        int ncol = 0;

        if (col!=board.length-1) { // if our colum is not the last colum
            nrow = row;
            ncol = col + 1;
        } else {  // if our colum is last colum then we will go next row's first colum
            nrow = row + 1;
            ncol = 0;
        }
        if (board [row][col] != '.') { // if board's row&col free. that meens already book by question text.
          if ( helper(board,nrow,ncol)){ //in this case we will call helper and rerun true.
              return true;
          } else {  // if board's row&col is free. that means we have to book then
              for (int i=1; i<=9; i++) {  // we fill the free space with 0-9 numbers.
                  if (isSafe(board,row,col,i)) { // is it safe to fill the number in board,raw,col.
                      board[row][col] = (char) (i + '0'); // if safe then fill it
                      if (helper(board,nrow,ncol)) { // then we will check by calling helper that is it returning true?
                          return  true; //if true
                      } else { // if not true. and we need to backtracking.
                          board[row][col] = '.'; // then we will null this box.
                      }
                  }
              }
          }
        }
        return false; // if all is not true.
    }
    public void solveSudoku ( char [][] board){
        helper(board,0,0);
    }
}




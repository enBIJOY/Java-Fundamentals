//Polymorphism//


class Car{
    String name;
    int model;

    // lets Create Some function with same name for overloading.
    public void printInfo(String name){
        System.out.println(name);
    }
    public void printInfo(int model){
        System.out.println(model);
    }

    //created one string type and one intiger type function. lets create different return type function

//    public long printInfo(int model){
//        System.out.println(model);
//    }

    // or create sequence of parameter.

    public void printInfo(String name, int model){
        System.out.println(name + " "+ model);
    }


}


public class Main {
    public static void main(String[] args){
        Car C1 = new Car();
        C1.name = "AudiR8";
        C1.model = 2003;

        C1.printInfo(C1.name,C1.model);  // Prints the car information
    }
}













